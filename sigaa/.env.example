# Base de datos: SQLite local (por defecto) o PostgreSQL
DATABASE_URL=sqlite:./data/sigaa.sqlite
# DATABASE_URL=postgres://usuario:clave@localhost:5432/sigaa

PORT=3000
HOST=0.0.0.0
# Clave para firmar las sesiones. En producción defina una cadena larga y aleatoria (si falta, se genera una por arranque y las sesiones se pierden al reiniciar).
SIGAA_JWT_SECRET=
# Clave inicial del usuario admin (se exige cambiarla al primer ingreso)
SIGAA_ADMIN_PASSWORD=Admin2026
# 1 = cargar datos de demostración si la base está vacía
SIGAA_DEMO=0
# Carpeta de fotografías de activos fijos y aplicación web compilada
SIGAA_FOTOS_DIR=./data/fotos
SIGAA_WEB_DIR=../web/dist
