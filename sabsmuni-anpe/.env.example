# ───────── SABSMUNI-ANPE · variables de entorno ─────────
# Copie a .env (o ejecute scripts/init-env.sh, que genera los secretos por usted).

# Base de datos PostgreSQL (solo accesible dentro de la red de Docker)
POSTGRES_PASSWORD=cambie-esta-contrasena-larga

# Firma de tokens JWT: mínimo 32 caracteres aleatorios  →  openssl rand -hex 32
JWT_SECRET=genere-con-openssl-rand-hex-32-genere-con-openssl

# URL pública del sistema (se usa en el QR de verificación y para CORS)
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Poner en true cuando se sirva por HTTPS (cookies con flag Secure)
COOKIE_SECURE=false

# Intentos de login por minuto y por IP
LOGIN_RATE_LIMIT=10

# Datos institucionales iniciales (editables luego en Administración)
GAM_NOMBRE=Gobierno Autónomo Municipal de Demostración

# Administrador inicial (obligatorio)
SEED_ADMIN_EMAIL=admin@gam.bo
SEED_ADMIN_PASSWORD=Cambie-Esta-Clave-123

# Solo para capacitación/evaluación: crea un usuario por rol y catálogos de ejemplo.
# NO activar en un despliegue real.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=
