# Copie a .env y cambie TODOS los secretos antes de operar.
POSTGRES_PASSWORD=cambiar-clave-bd
SECRET_KEY=cambiar-por-una-cadena-aleatoria-de-64-caracteres
# Opcional: clave Fernet (base64 urlsafe de 32 bytes) para cifrar ofertas selladas. Vacio = derivada de SECRET_KEY
FERNET_KEY=
MINIO_ROOT_USER=sicomminio
MINIO_ROOT_PASSWORD=cambiar-clave-minio
# URL publica del sistema (se imprime en el QR de cada PDF)
PUBLIC_BASE_URL=http://localhost:3000
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
