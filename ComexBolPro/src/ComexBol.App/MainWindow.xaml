<Window x:Class="ComexBol.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ComexBol.App.Vistas"
        Title="COMEX JB — Gestión de Importaciones" Icon="/Assets/simbolo.png" Width="1500" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource Fondo}" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Texto}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- ===================== Menú lateral ===================== -->
    <Border>
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#405361" Offset="0"/><GradientStop Color="#2F3E49" Offset="1"/></LinearGradientBrush></Border.Background>
      <DockPanel Margin="14,16">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,6">
          <StackPanel><Image Source="/Assets/logo.png" Height="118"/></StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Gestión de importaciones" Foreground="#B9D3D6" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <!-- Usuario -->
        <Border DockPanel.Dock="Bottom" Background="#33495A" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="{Binding NombreMostrado}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding RolMostrado}" Foreground="{StaticResource Menta}" FontSize="11" Margin="0,0,0,8"/>
            <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCmd}" Style="{StaticResource BtnSuave}" Margin="0" HorizontalAlignment="Stretch" Padding="10,5"/>
          </StackPanel>
        </Border>

        <StackPanel>
          <RadioButton Style="{StaticResource NavItem}" Content="Panel de control" GroupName="nav" Command="{Binding IrCmd}" CommandParameter="Panel" IsChecked="{Binding EsPanel, Mode=OneWay}"/>
          <RadioButton Style="{StaticResource NavItem}" Content="Operaciones" GroupName="nav" Command="{Binding IrCmd}" CommandParameter="Operaciones" IsChecked="{Binding EsOperaciones, Mode=OneWay}"/>
          <RadioButton Style="{StaticResource NavItem}" Content="Arancel" GroupName="nav" Command="{Binding IrCmd}" CommandParameter="Arancel" IsChecked="{Binding EsArancel, Mode=OneWay}"/>
          <RadioButton Style="{StaticResource NavItem}" Content="Configuración" GroupName="nav" Command="{Binding IrCmd}" CommandParameter="Configuración" IsChecked="{Binding EsConfiguracion, Mode=OneWay}"/>
          <RadioButton Style="{StaticResource NavItem}" Content="Acerca de" GroupName="nav" Command="{Binding IrCmd}" CommandParameter="Acerca" IsChecked="{Binding EsAcerca, Mode=OneWay}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== Contenido ===================== -->
    <Grid Grid.Column="1">
      <v:PanelView DataContext="{Binding Panel}" Visibility="{Binding DataContext.EsPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
      <v:OperacionesView DataContext="{Binding Operaciones}" Visibility="{Binding DataContext.EsOperaciones, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
      <v:ArancelView DataContext="{Binding Catalogo}" Visibility="{Binding DataContext.EsArancel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
      <v:ConfiguracionView DataContext="{Binding Config}" Visibility="{Binding DataContext.EsConfiguracion, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
      <v:AcercaView Visibility="{Binding EsAcerca, Converter={StaticResource BoolVis}}"/>
    </Grid>
  </Grid>
</Window>
