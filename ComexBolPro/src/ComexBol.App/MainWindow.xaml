<Window x:Class="ComexBol.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComexBol Pro — Gestión de Importaciones" Width="1380" Height="840" Background="{StaticResource Fondo}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="92"/><RowDefinition Height="26"/>
    </Grid.RowDefinitions>

    <!-- Barra superior -->
    <Border Background="{StaticResource Marino}">
      <DockPanel Margin="14,0">
        <TextBlock Text="ComexBol Pro" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="TC USD→Bs (BCB, venta):" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Width="70" Text="{Binding TipoCambioUsd, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,0,14,0"/>
          <Button Content="Importar catálogo…" Click="ImportarCatalogo_Click"/>
          <Button Content="Exportar expediente…" Click="ExportarExpediente_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Navegación: operaciones -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,1,0" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Nueva importación" Style="{StaticResource Titulo}"/>
            <TextBox Text="{Binding NuevaCarpeta, UpdateSourceTrigger=PropertyChanged}" ToolTip="N.º de carpeta"/>
            <ComboBox ItemsSource="{Binding Incoterms}" SelectedItem="{Binding NuevoIncoterm}" Margin="0,6"/>
            <Button Content="Crear" Command="{Binding NuevaImportacionCmd}" HorizontalAlignment="Left"/>
            <TextBlock Text="Operaciones" Style="{StaticResource Titulo}"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Operaciones}" SelectedItem="{Binding Seleccionada}" DisplayMemberPath="Carpeta"/>
        </DockPanel>
      </Border>

      <TabControl Grid.Column="1" Margin="8">
        <!-- Captura + visor dual -->
        <TabItem Header="Ítems y documento">
          <Grid Margin="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource Borde}" BorderThickness="1" Background="White">
              <DockPanel>
                <Button DockPanel.Dock="Top" Content="Abrir y leer con OCR (JPG/PNG)…" Click="AbrirDocumento_Click" HorizontalAlignment="Left" Margin="6"/>
                <Image Source="{Binding DocumentoRuta}" Stretch="Uniform"/>
              </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Formulario de captura" Style="{StaticResource Titulo}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="Partida NANDINA" Margin="0,4"/><TextBox Grid.Column="1" Text="{Binding ItemPartida, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                  <TextBlock Grid.Row="1" Text="Descripción" Margin="0,4"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItemDescripcion}" Margin="0,2"/>
                  <TextBlock Grid.Row="2" Text="Valor factura" Margin="0,4"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ItemValor}" Margin="0,2"/>
                  <TextBlock Grid.Row="3" Text="Peso bruto kg" Margin="0,4"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ItemPesoBruto}" Margin="0,2"/>
                  <TextBlock Grid.Row="4" Text="Flete / Seguro" Margin="0,4"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                    <TextBox Width="100" Text="{Binding Flete}"/><TextBox Width="100" Text="{Binding Seguro}" Margin="6,0,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8">
                    <Button Content="Agregar ítem" Command="{Binding AgregarItemCmd}"/>
                    <Button Content="Calcular (F5)" Command="{Binding LiquidarCmd}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <StackPanel DockPanel.Dock="Top" Visibility="{Binding Propuesta.Count, Converter={StaticResource HayPropuesta}}">
                <TextBlock Text="Propuesta del OCR — revise cada campo" Style="{StaticResource Titulo}"/>
                <ItemsControl ItemsSource="{Binding Propuesta}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Grid Margin="0,2" ToolTip="{Binding Origen}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Nombre}"/><TextBox Grid.Column="1" Text="{Binding Valor}"/><TextBlock Grid.Column="2" Text="{Binding Confianza}" Margin="6,0" Foreground="#9A6700"/>
                  </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Content="Confirmar datos" Command="{Binding ConfirmarPropuestaCmd}" HorizontalAlignment="Left" Margin="0,6,0,10"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </DockPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Liquidación">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Liquidacion}" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate><DataTemplate>
                <DockPanel>
                  <TextBlock Text="{Binding Monto}" DockPanel.Dock="Right" FontFamily="Consolas"/>
                  <TextBlock Text="{Binding Concepto}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{x:Null}">
                    <Style.Triggers><DataTrigger Binding="{Binding Destacada}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style></TextBlock>
                </DockPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <TextBlock Text="Avisos" Style="{StaticResource Titulo}"/>
              <ItemsControl ItemsSource="{Binding Avisos}"><ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="#9A6700"/>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Ruta crítica">
          <DataGrid ItemsSource="{Binding Etapas}" AutoGenerateColumns="False" IsReadOnly="True" Margin="6" x:Name="GridEtapas">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="●" Width="30"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <Ellipse Width="14" Height="14" Fill="{Binding ColorHex}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Etapa" Binding="{Binding Codigo}" Width="60"/>
              <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*"/>
              <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="110"/>
              <DataGridTextColumn Header="Real" Binding="{Binding Real}" Width="70"/>
              <DataGridTextColumn Header="Estado" Binding="{Binding Semaforo}" Width="90"/>
              <DataGridCheckBoxColumn Header="Crítica" Binding="{Binding EsCritica}" Width="60"/>
              <DataGridTemplateColumn Header="" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <Button Content="Marcar cumplida" Click="Cumplir_Click" Tag="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <TabItem Header="Legajo y bitácora">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Documentos exigidos" Style="{StaticResource Titulo}"/>
              <ItemsControl ItemsSource="{Binding Legajo}"><ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <TextBlock Width="22"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✖"/><Setter Property="Foreground" Value="#D64545"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Presente}" Value="True"><Setter Property="Text" Value="✔"/><Setter Property="Foreground" Value="#2E9E5B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Text="{Binding Documento}" Width="130" FontWeight="SemiBold"/><TextBlock Text="{Binding Motivo}"/>
                </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <DockPanel Grid.Column="1" Margin="14,0,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Bitácora" Style="{StaticResource Titulo}"/>
              <ListBox ItemsSource="{Binding Bitacora}"/>
            </DockPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Barra de ruta crítica -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="12,6">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Etapas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,0" ToolTip="{Binding Nombre}">
            <Ellipse Width="16" Height="16" Fill="{Binding ColorHex}"/><TextBlock Text="{Binding Codigo}" FontSize="10" HorizontalAlignment="Center"/>
          </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Margin="0,6,0,0"><Run Text="{Binding ResumenSemaforos, Mode=OneWay}"/><Run Text="    "/><Run Text="{Binding ProximoVencimiento, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="#E8ECF1"><TextBlock Text="{Binding Mensaje}" Margin="12,0" VerticalAlignment="Center"/></Border>
  </Grid>
</Window>
