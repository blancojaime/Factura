<Application x:Class="ComexBol.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ComexBol.App"
             ShutdownMode="OnExplicitShutdown" Startup="OnStartup">
  <Application.Resources>
    <!-- ===== Paleta: tomada del logo de COMEX JB (pizarra, turquesa, menta) + colores de apoyo ===== -->
    <SolidColorBrush x:Key="Pizarra" Color="#405361"/>
    <SolidColorBrush x:Key="PizarraOscura" Color="#2F3E49"/>
    <SolidColorBrush x:Key="Turquesa" Color="#5EA3A0"/>
    <SolidColorBrush x:Key="TurquesaOscuro" Color="#468885"/>
    <SolidColorBrush x:Key="Menta" Color="#98D3D1"/>
    <SolidColorBrush x:Key="MentaClara" Color="#E6F4F3"/>
    <SolidColorBrush x:Key="Fondo" Color="#F2F6F7"/>
    <SolidColorBrush x:Key="Tarjeta" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Borde" Color="#D3DEE2"/>
    <SolidColorBrush x:Key="Texto" Color="#25323A"/>
    <SolidColorBrush x:Key="TextoSuave" Color="#6B7C85"/>
    <SolidColorBrush x:Key="Ambar" Color="#F0A53A"/>
    <SolidColorBrush x:Key="Verde" Color="#3CB07C"/>
    <SolidColorBrush x:Key="Rojo" Color="#D9534F"/>
    <SolidColorBrush x:Key="Azul" Color="#3F8FD2"/>
    <SolidColorBrush x:Key="Violeta" Color="#8571C4"/>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:NegarBoolVisibilidad x:Key="NoBoolVis"/>
    <local:HayElementosConverter x:Key="HayPropuesta"/>
    <local:ColorTextoConverter x:Key="ColorTexto"/>
    <local:TituloEditorConverter x:Key="TituloEditor"/>

    <!-- ===== Texto ===== -->
    <!-- El color de texto base se define en cada ventana (Foreground) para que los controles con fondo oscuro puedan heredar el suyo. -->
    <Style x:Key="Titulo" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Pizarra}"/></Style>
    <Style x:Key="Subtitulo" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Pizarra}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextoSuave}"/><Setter Property="Margin" Value="2,0,0,2"/></Style>
    <Style x:Key="Suave" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextoSuave}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>

    <!-- ===== Tarjetas ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Tarjeta}"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ===== Botones ===== -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Turquesa}"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fondo" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fondo" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
    <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}"><Setter Property="Background" Value="{StaticResource Pizarra}"/></Style>
    <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource BtnBase}"><Setter Property="Background" Value="{StaticResource Rojo}"/></Style>
    <Style x:Key="BtnExito" TargetType="Button" BasedOn="{StaticResource BtnBase}"><Setter Property="Background" Value="{StaticResource Verde}"/></Style>
    <Style x:Key="BtnSuave" TargetType="Button" BasedOn="{StaticResource BtnBase}"><Setter Property="Background" Value="{StaticResource MentaClara}"/><Setter Property="Foreground" Value="{StaticResource Pizarra}"/></Style>

    <!-- ===== Menú lateral ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#D8E6E8"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Fondo" Background="Transparent" CornerRadius="6" Padding="14,10">
              <Grid>
                <Border x:Name="Barra" Width="4" Background="{StaticResource Menta}" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,-4,0,-4" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="Background" Value="#4C6372"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="#5A7383"/><Setter TargetName="Barra" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Campos ===== -->
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Padding" Value="6,5"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Turquesa}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Padding" Value="6,5"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Foreground" Value="{StaticResource Texto}"/></Style>

    <!-- ===== Pestañas ===== -->
    <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0,8,0,0"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Cabecera" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="16,9" Margin="0,0,4,0" Cursor="Hand">
              <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource TextoSuave}" TextElement.FontWeight="Normal"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cabecera" Property="Background" Value="{StaticResource MentaClara}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Cabecera" Property="BorderBrush" Value="{StaticResource Turquesa}"/><Setter TargetName="Cabecera" Property="Background" Value="White"/>
                <Setter TargetName="Cabecera" Property="TextElement.Foreground" Value="{StaticResource Pizarra}"/><Setter TargetName="Cabecera" Property="TextElement.FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Tablas ===== -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Borde}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E4ECEE"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F6FAFA"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="MinRowHeight" Value="30"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Pizarra}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="BorderBrush" Value="#566B79"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Menta}"/><Setter Property="Foreground" Value="{StaticResource PizarraOscura}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource MentaClara}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource PizarraOscura}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ListBox"><Setter Property="BorderBrush" Value="{StaticResource Borde}"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Menta}"/><Setter Property="Foreground" Value="{StaticResource PizarraOscura}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource MentaClara}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
