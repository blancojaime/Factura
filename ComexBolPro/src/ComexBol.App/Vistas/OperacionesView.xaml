<UserControl x:Class="ComexBol.App.Vistas.OperacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.InputBindings><KeyBinding Key="F5" Command="{Binding LiquidarCmd}"/></UserControl.InputBindings>
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- ===================== Columna izquierda: crear y elegir operación ===================== -->
    <DockPanel Margin="0,0,16,0">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Nueva importación" Style="{StaticResource Subtitulo}"/>
          <TextBlock Text="N.º de carpeta" Style="{StaticResource Etiqueta}"/>
          <TextBox Text="{Binding NuevaCarpeta, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Incoterm pactado" Style="{StaticResource Etiqueta}"/>
          <ComboBox ItemsSource="{Binding Incoterms}" SelectedItem="{Binding NuevoIncoterm}"/>
          <Button Content="Crear importación" Command="{Binding NuevaImportacionCmd}" HorizontalAlignment="Stretch" Margin="0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Operaciones" Style="{StaticResource Subtitulo}"/>
          <TextBlock DockPanel.Dock="Top" Text="Buscar" Style="{StaticResource Etiqueta}"/>
          <TextBox DockPanel.Dock="Top" Text="{Binding FiltroOperaciones, UpdateSourceTrigger=PropertyChanged}"/>
          <Button DockPanel.Dock="Bottom" Style="{StaticResource BtnPeligro}" Content="Eliminar operación" Click="EliminarOperacion_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
          <ListBox ItemsSource="{Binding Operaciones}" SelectedItem="{Binding Seleccionada}" DisplayMemberPath="Carpeta"/>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- ===================== Columna derecha: trabajo sobre la operación ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- Encabezado: operación, tipo de cambio y exportaciones -->
      <Border Style="{StaticResource Card}" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Seleccionada.Carpeta}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Pizarra}" VerticalAlignment="Center"/>
            <Border CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource MentaClara}"/><Style.Triggers><DataTrigger Binding="{Binding Seleccionada}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock Text="{Binding Seleccionada.Incoterm}" Foreground="{StaticResource Pizarra}" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Seleccione o cree una operación" Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Seleccionada}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,14,0">
              <TextBlock Text="TC USD a Bs (oficial BCB, venta)" Style="{StaticResource Etiqueta}"/>
              <StackPanel Orientation="Horizontal">
                <TextBox Width="80" Text="{Binding TipoCambioUsd, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0"/>
                <Button Content="Guardar" Command="{Binding GuardarTcCmd}" Style="{StaticResource BtnSuave}" Margin="6,0,0,0" Padding="10,5" ToolTip="Guarda este tipo de cambio para hoy en la tabla de Configuración"/>
              </StackPanel>
              <TextBlock Text="{Binding TcInfo}" Style="{StaticResource Etiqueta}" Margin="2,3,0,0"/>
            </StackPanel>
            <Button Content="Excel" Style="{StaticResource BtnExito}" Click="ExportarExcel_Click" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button Content="JSON (SUMA)" Style="{StaticResource BtnSecundario}" Click="ExportarJson_Click" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Datos estructurados para transcribir a la DMI"/>
            <Button Content="Expediente" Style="{StaticResource BtnSecundario}" Click="ExportarExpediente_Click" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="1" SelectedIndex="0">
        <!-- ===================== MERCANCÍAS ===================== -->
        <TabItem Header="Mercancías">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.15*" MinWidth="470"/></Grid.ColumnDefinitions>

            <!-- Ítems + visor de documento -->
            <Border Style="{StaticResource Card}" Margin="0" Padding="12">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Ítems de la operación" Style="{StaticResource Subtitulo}"/>
                <Grid Grid.Row="1" Margin="0,4,0,0"><DataGrid x:Name="GridItems" ItemsSource="{Binding Items}" SelectedItem="{Binding ItemSeleccionado}" IsReadOnly="True" MinHeight="90" MouseDoubleClick="GridItems_DoubleClick">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="N.º" Binding="{Binding Numero}" Width="42"/>
                        <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="104"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="92"/>
                        <DataGridTextColumn Header="GA" Binding="{Binding GA}" Width="48"/>
                      </DataGrid.Columns>
                    </DataGrid></Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                  <Button Content="Editar ítem" Command="{Binding EditarItemCmd}" Style="{StaticResource BtnSecundario}"/>
                  <Button Content="Eliminar ítem" Style="{StaticResource BtnPeligro}" Click="EliminarItem_Click"/>
                  <Button Content="Leer factura" ToolTip="Abrir una factura y leerla con OCR" Click="AbrirDocumento_Click" Style="{StaticResource BtnSuave}"/>
                </StackPanel>
                <Border Grid.Row="3" Height="110" Background="#F7FAFA" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="4"><Image Source="{Binding DocumentoRuta}" Stretch="Uniform"/></Border>
              </Grid>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Formulario + lista de ítems -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Propuesta del OCR -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Propuesta.Count, Converter={StaticResource HayPropuesta}}" Background="#FFF8E8" BorderBrush="{StaticResource Ambar}">
                  <StackPanel>
                    <TextBlock Text="Propuesta de la lectura de la factura: revise cada dato" Style="{StaticResource Subtitulo}"/>
                    <ItemsControl ItemsSource="{Binding Propuesta}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2" ToolTip="{Binding Origen}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Valor}" Margin="0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Confianza}" Margin="8,0,0,0" Foreground="{StaticResource Ambar}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="Confirmar datos" Command="{Binding ConfirmarPropuestaCmd}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}"><Run Text="{Binding TextoGuardarItem, Mode=OneWay}"/></TextBlock>

                    <TextBlock Text="Partida NANDINA: escriba un código o el nombre del producto y elija de la lista" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPartida" Text="{Binding ItemPartida, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="TxtPartida_PreviewKeyDown" Margin="0,0,0,2"/>
                    <Popup x:Name="PopSugerencias" IsOpen="{Binding MostrarSugerencias, Mode=TwoWay}" PlacementTarget="{Binding ElementName=TxtPartida}" Placement="Bottom" StaysOpen="False" Width="560" AllowsTransparency="True">
                      <Border Background="White" BorderBrush="{StaticResource Turquesa}" BorderThickness="1" CornerRadius="6" Margin="0,2,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                        <ListBox x:Name="ListaSugerencias" ItemsSource="{Binding Sugerencias}" MaxHeight="300" BorderThickness="0" SelectionChanged="Sugerencia_Elegida" KeyDown="ListaSugerencias_KeyDown">
                          <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                              <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Codigo}" FontWeight="Bold" Foreground="{StaticResource TurquesaOscuro}" Margin="0,0,10,0"/><TextBlock Text="{Binding Info}" Style="{StaticResource Suave}" FontSize="11"/></StackPanel>
                              <TextBlock Text="{Binding Corta}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                          </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                      </Border>
                    </Popup>
                    <TextBlock Text="{Binding InfoPartida}" Foreground="{StaticResource TurquesaOscuro}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Text="Descripción de la mercancía (se completa sola al elegir la partida; puede editarla)" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding ItemDescripcion}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="46" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Valor de factura (USD)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemValor}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Cantidad (unid.)" Style="{StaticResource Etiqueta}" ToolTip="Para el precio unitario y el costo por unidad"/><TextBox Text="{Binding ItemCantidad}" ToolTip="Para el precio unitario y el costo por unidad"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="Peso bruto (kg)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemPesoBruto}"/></StackPanel>
                      <StackPanel Grid.Column="6"><TextBlock Text="Antigüedad (años)" Style="{StaticResource Etiqueta}" ToolTip="Solo vehículos: 0 = nuevo"/><TextBox Text="{Binding ItemAntiguedad}" ToolTip="Solo vehículos: 0 = nuevo"/></StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Marca" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemMarca}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Modelo" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemModelo}"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="N.º de serie" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemSerie}"/></StackPanel>
                      <StackPanel Grid.Column="6"><TextBlock Text="País de origen" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ItemPais}"/></StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Acuerdo comercial" Style="{StaticResource Etiqueta}" ToolTip="Solo con Certificado de Origen"/><ComboBox ItemsSource="{Binding Acuerdos}" SelectedItem="{Binding ItemAcuerdo}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Desgravación %" Style="{StaticResource Etiqueta}" ToolTip="Con 0, se toma la preferencia del arancel para el acuerdo elegido"/><TextBox Text="{Binding ItemDesgravacionPct}" ToolTip="Con 0, se toma la preferencia del arancel para el acuerdo elegido"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="ICE % (manual)" Style="{StaticResource Etiqueta}" ToolTip="Solo si el arancel no trae la tasa (bebidas, tabaco)"/><TextBox Text="{Binding ItemIcePct}" ToolTip="Solo si el arancel no trae la tasa (bebidas, tabaco)"/></StackPanel>
                    </Grid>
                    <Border Background="{StaticResource MentaClara}" CornerRadius="6" Padding="10,8" Margin="0,2,0,10">
                      <StackPanel>
                        <TextBlock Text="Costos de la operación (en USD; solo los que el Incoterm no incluye)" Style="{StaticResource Etiqueta}"/>
                        <StackPanel Orientation="Horizontal">
                          <StackPanel Margin="0,0,10,0"><TextBlock Text="Flete internacional" Style="{StaticResource Etiqueta}"/><TextBox Width="130" Text="{Binding Flete}" Margin="0"/></StackPanel>
                          <StackPanel><TextBlock Text="Seguro" Style="{StaticResource Etiqueta}"/><TextBox Width="130" Text="{Binding Seguro}" Margin="0"/></StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                      <Button Content="{Binding TextoGuardarItem}" Command="{Binding AgregarItemCmd}" Style="{StaticResource BtnExito}"/>
                      <Button Content="Limpiar" Command="{Binding NuevoItemCmd}" Style="{StaticResource BtnSuave}" ToolTip="Limpia el formulario o cancela la edición"/>
                      <Button Content="Calcular (F5)" Command="{Binding LiquidarCmd}" ToolTip="Calcula la liquidación de tributos"/>
                    </StackPanel>
                  </StackPanel>
                </Border>


              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- ===================== VALORACIÓN (DAV) ===================== -->
        <TabItem Header="Valoración">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel DataContext="{Binding Valoracion}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="1 · Cuestionario de descarte del Primer Método (valor de transacción)" Style="{StaticResource Subtitulo}"/>
                <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Decisión 571 de la CAN y Resolución 1684. Marque «Sí» solo lo que ocurra en esta compra; el sistema le dice si el valor de transacción sigue siendo aplicable."/>
                <CheckBox Content="¿Comprador y vendedor están vinculados?" IsChecked="{Binding Vinculacion}" Margin="0,4"/>
                <CheckBox Content="      …y la vinculación influyó en el precio" IsChecked="{Binding VinculacionInfluyo}" IsEnabled="{Binding PuedeInfluir}" Margin="0,4"/>
                <CheckBox Content="¿Hay restricciones a la cesión o utilización de la mercancía (distintas de las legales o geográficas)?" IsChecked="{Binding Restricciones}" Margin="0,4"/>
                <CheckBox Content="¿El precio depende de condiciones o contraprestaciones cuyo valor no puede determinarse?" IsChecked="{Binding Condiciones}" Margin="0,4"/>
                <CheckBox Content="¿Parte del producto de la reventa o utilización posterior revierte al vendedor?" IsChecked="{Binding Reversion}" Margin="0,4"/>
                <Border CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Background="{Binding ResultadoColor}"><TextBlock Text="{Binding ResultadoDescarte}" Foreground="White" FontWeight="Bold"/></Border>
                <ItemsControl ItemsSource="{Binding Observaciones}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="#8A5A00"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="2 · Ajustes del Art. 8 (en la moneda de la factura)" Style="{StaticResource Subtitulo}"/>
                <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Anote solo lo que NO está incluido en el precio de la factura. Las adiciones suben el valor en aduana; las deducciones (si están desglosadas en la factura) lo bajan."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ADICIONES" FontWeight="Bold" Foreground="{StaticResource TurquesaOscuro}"/>
                    <TextBlock Text="Comisiones y corretajes (excepto comisión de compra)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Comisiones}"/>
                    <TextBlock Text="Envases y embalajes" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Envases}"/>
                    <TextBlock Text="Prestaciones (assists): matrices, moldes, planos, diseños hechos fuera del país" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Assists}"/>
                    <TextBlock Text="Cánones y derechos de licencia (royalties)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Royalties}"/>
                    <TextBlock Text="Reversiones al vendedor" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Reversiones}"/>
                    <TextBlock Text="Otras adiciones" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding OtrasAdiciones}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DEDUCCIONES" FontWeight="Bold" Foreground="{StaticResource TurquesaOscuro}"/>
                    <TextBlock Text="Armado, montaje o asistencia técnica posteriores a la importación" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ArmadoPosterior}"/>
                    <TextBlock Text="Transporte posterior al lugar de importación" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding TransportePosterior}"/>
                    <TextBlock Text="Derechos e impuestos aplicables en Bolivia incluidos en el precio" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding ImpuestosBolivia}"/>
                    <TextBlock Text="Notas de sustento (contrato, factura de royalty, etc.)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Notas}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" VerticalContentAlignment="Top"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding TotalesAjustes}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Guardar valoración" Command="{Binding GuardarCmd}" Style="{StaticResource BtnExito}"/>
                  <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8A5A00" TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="3 · Validador previo de precios (riesgo de duda razonable)" Style="{StaticResource Subtitulo}"/>
                <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Compara el precio unitario de cada ítem (valor ÷ cantidad) con el de sus operaciones anteriores de la misma partida. Requiere la cantidad en cada ítem."/>
                <Button Content="Validar precios" Command="{Binding ValidarPreciosCmd}" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left"/>
                <DataGrid ItemsSource="{Binding Precios}" IsReadOnly="True" MinHeight="70" MaxHeight="220" Margin="0,8,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="N.º" Binding="{Binding N}" Width="44"/>
                    <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="104"/>
                    <DataGridTextColumn Header="Precio unit." Binding="{Binding PrecioUnitario}" Width="96"/>
                    <DataGridTextColumn Header="Mediana hist." Binding="{Binding Referencia}" Width="104"/>
                    <DataGridTextColumn Header="Desviación" Binding="{Binding Desviacion}" Width="92"/>
                    <DataGridTextColumn Header="Riesgo" Binding="{Binding Riesgo}" Width="110"/>
                    <DataGridTextColumn Header="Detalle" Binding="{Binding Mensaje}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <!-- ===================== LIQUIDACIÓN ===================== -->
        <TabItem Header="Liquidación">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <Border Style="{StaticResource Card}" DataContext="{Binding Detalle}">
                  <StackPanel>
                    <TextBlock Text="1 · Determinación del valor en aduana (CIF frontera)" Style="{StaticResource Subtitulo}"/>
                    <ItemsControl ItemsSource="{Binding Desglose}"><ItemsControl.ItemTemplate><DataTemplate>
                      <DockPanel Margin="0,4">
                        <TextBlock Text="{Binding Monto}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Concepto}" TextWrapping="Wrap" Margin="0,0,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Destacada}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </DockPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="2 · Tributos a pagar (Bs)" Style="{StaticResource Subtitulo}"/>
                    <ListBox ItemsSource="{Binding Liquidacion}" HorizontalContentAlignment="Stretch" FontSize="14" BorderThickness="0" Focusable="False">
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,6"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E6EEF0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate>
                        <DockPanel>
                          <TextBlock Text="{Binding Monto}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Concepto}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Destacada}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </DockPanel>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Background="#FFF8E8" BorderBrush="#F3D9A4">
                  <StackPanel>
                    <TextBlock Text="Avisos y observaciones" Style="{StaticResource Subtitulo}"/>
                    <ItemsControl ItemsSource="{Binding Avisos}"><ItemsControl.ItemTemplate><DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" Foreground="#8A5A00"/>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0" DataContext="{Binding Detalle}">
                  <StackPanel>
                    <TextBlock Text="3 · Cómo se calculó (fórmulas)" Style="{StaticResource Subtitulo}"/>
                    <ItemsControl ItemsSource="{Binding Pasos}"><ItemsControl.ItemTemplate><DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="12"/>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}" DataContext="{Binding Detalle}">
              <StackPanel>
                <TextBlock Text="4 · Liquidación por ítem (Bs)" Style="{StaticResource Subtitulo}"/>
                <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" MinHeight="70" MaxHeight="240">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="N.º" Binding="{Binding N}" Width="44"/>
                    <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="112"/>
                    <DataGridTextColumn Header="FOB" Binding="{Binding Fob}" Width="*"/>
                    <DataGridTextColumn Header="CIF" Binding="{Binding Cif}" Width="*"/>
                    <DataGridTextColumn Header="GA" Binding="{Binding GA}" Width="*"/>
                    <DataGridTextColumn Header="ICE" Binding="{Binding ICE}" Width="*"/>
                    <DataGridTextColumn Header="IEHD" Binding="{Binding IEHD}" Width="*"/>
                    <DataGridTextColumn Header="IVA" Binding="{Binding IVA}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" DataContext="{Binding Detalle}">
              <StackPanel>
                <TextBlock Text="5 · Gastos de despacho y costo nacionalizado por ítem" Style="{StaticResource Subtitulo}"/>
                <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Anote en bolivianos lo que pagará además de los tributos. El IVA se trata como crédito fiscal (no es costo) salvo que lo cambie en Configuración."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Agencia despachante (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Honorarios}"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Almacenaje (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Almacenaje}"/></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock Text="Transporte interno (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding TransporteInterno}"/></StackPanel>
                  <StackPanel Grid.Column="6"><TextBlock Text="Otros gastos (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding OtrosGastos}"/></StackPanel>
                  <StackPanel Grid.Column="8"><TextBlock Text="Días en almacén" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding DiasAlmacenaje}"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                  <Button Content="Guardar gastos" Command="{Binding GuardarGastosCmd}" Style="{StaticResource BtnExito}"/>
                  <Button Content="Estimar almacenaje" Command="{Binding EstimarAlmacenajeCmd}" Style="{StaticResource BtnSecundario}" ToolTip="Con la tarifa del recinto configurada"/>
                  <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#8A5A00" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Costeo}" IsReadOnly="True" MinHeight="70" MaxHeight="220">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="N.º" Binding="{Binding N}" Width="44"/>
                    <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="112"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="*"/>
                    <DataGridTextColumn Header="CIF" Binding="{Binding Cif}" Width="*"/>
                    <DataGridTextColumn Header="GA+ICE+IEHD" Binding="{Binding Tributos}" Width="*"/>
                    <DataGridTextColumn Header="Gastos" Binding="{Binding Gastos}" Width="*"/>
                    <DataGridTextColumn Header="Costo total" Binding="{Binding Costo}" Width="*"/>
                    <DataGridTextColumn Header="Factor" Binding="{Binding Factor}" Width="*"/>
                    <DataGridTextColumn Header="Costo unitario" Binding="{Binding Unitario}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding ResumenCosteo}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding FlujoCaja}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TurquesaOscuro}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <!-- ===================== DESPACHO (DIM) ===================== -->
        <TabItem Header="Despacho">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><Grid DataContext="{Binding Despacho}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="1 · Datos de la DIM (Declaración de Importación de Mercancías)" Style="{StaticResource Subtitulo}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Tipo de despacho" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoDespacho}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Régimen aduanero" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Regimenes}" SelectedItem="{Binding Regimen}"/></StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Aduana de ingreso" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding AduanaIngreso}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Aduana de destino" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding AduanaDestino}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Código de declarante (ADA)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding CodigoDeclarante}"/></StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Modalidad de transporte" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding Modalidad}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding EtiquetaEmbarque}" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding NroDocEmbarque}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="{Binding EtiquetaManifiesto}" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding NroManifiesto}"/></StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Bultos (manifiesto)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Bultos}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Peso bruto manifiesto (kg)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding PesoManifiesto}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="N.º de DAV" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding NroDav}"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="N.º de DIM" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding NroDim}"/></StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Guardar" Command="{Binding GuardarCmd}" Style="{StaticResource BtnExito}"/>
                    <Button Content="Validar la DIM" Command="{Binding ValidarCmd}" Style="{StaticResource BtnSecundario}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Mensaje}" Foreground="#8A5A00" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="2 · Validación previa de la DIM" Style="{StaticResource Subtitulo}"/>
                  <Border CornerRadius="6" Padding="10,6" Background="{Binding EstadoDimColor}" Margin="0,0,0,6"><TextBlock Text="{Binding EstadoDim}" Foreground="White" FontWeight="Bold"/></Border>
                  <ItemsControl ItemsSource="{Binding Hallazgos}"><ItemsControl.ItemTemplate><DataTemplate>
                    <DockPanel Margin="0,3">
                      <Border DockPanel.Dock="Left" CornerRadius="9" Padding="8,1" Margin="0,0,8,0" Width="68" Background="{Binding ColorHex}" VerticalAlignment="Top"><TextBlock Text="{Binding Nivel}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                      <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"/>
                    </DockPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="3 · Canal de selectividad" Style="{StaticResource Subtitulo}"/>
                  <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Elija el canal que asignó la Aduana: el sistema genera la lista de control que corresponde."/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Canal" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Canales}" SelectedItem="{Binding Canal}"/></StackPanel>
                    <Border Grid.Column="2" CornerRadius="6" Margin="0,18,0,0" Background="{Binding ColorCanal}" Height="34"><TextBlock Text="{Binding Canal}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                  </Grid>
                  <TextBlock Text="Observaciones de la Aduana (acta, notificación)" Style="{StaticResource Etiqueta}"/>
                  <TextBox Text="{Binding ObservacionAduana}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" VerticalContentAlignment="Top"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                    <Button Content="Asignar canal y generar lista" Command="{Binding AsignarCanalCmd}" Style="{StaticResource BtnExito}"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Tareas}"><ItemsControl.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding Hecha}" Margin="0,4"><TextBlock Text="{Binding Texto}" TextWrapping="Wrap" MaxWidth="470"/></CheckBox>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="4 · Levante" Style="{StaticResource Subtitulo}"/>
                  <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding FechaLevante}" Width="170"/>
                    <Button Content="Registrar levante" Command="{Binding LevanteCmd}" Style="{StaticResource BtnSecundario}" Margin="10,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                  <TextBlock Text="5 · Duda razonable y descargos" Style="{StaticResource Subtitulo}"/>
                  <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Si la Aduana emite un Acta de Reconocimiento o un Informe de Variación de Valor, genere el borrador de respuesta con la lista de pruebas (SWIFT, transferencias, cartas de crédito, listas de precios, catálogos)."/>
                  <Button Content="Generar borrador de descargos…" Click="Descargo_Click" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid></ScrollViewer>
        </TabItem>

        <!-- ===================== DECISIÓN ===================== -->
        <TabItem Header="Decisión">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel DataContext="{Binding Decision}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="¿Qué oferta conviene? Compare Incoterms, costo por unidad y margen" Style="{StaticResource Subtitulo}"/>
                <StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Unidades" Style="{StaticResource Etiqueta}"/><TextBox Width="90" Text="{Binding Unidades}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Gastos locales (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="120" Text="{Binding GastosLocalesBob}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Precio de mercado c/IVA (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="140" Text="{Binding PrecioMercadoConIva}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Margen objetivo %" Style="{StaticResource Etiqueta}"/><TextBox Width="90" Text="{Binding MargenObjetivoPct}"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Agregar escenario" Command="{Binding AgregarEscenarioCmd}" Style="{StaticResource BtnSecundario}"/>
                  <Button Content="Comparar" Command="{Binding CompararCmd}"/>
                  <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="10,0" Foreground="#8A5A00"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Ofertas a comparar" Style="{StaticResource Subtitulo}"/>
                <DataGrid ItemsSource="{Binding Escenarios}" CanUserAddRows="False" MinHeight="80" MaxHeight="190">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Escenario" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTemplateColumn Header="Incoterm" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <ComboBox Margin="0" ItemsSource="{Binding DataContext.Incoterms, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Incoterm, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Valor oferta" Binding="{Binding ValorFactura}" Width="100"/>
                    <DataGridTextColumn Header="Flete" Binding="{Binding Flete}" Width="80"/>
                    <DataGridTextColumn Header="Seguro" Binding="{Binding Seguro}" Width="80"/>
                    <DataGridTextColumn Header="Deduc. post-frontera" Binding="{Binding DeduccionesPostFrontera}" Width="140"/>
                    <DataGridTemplateColumn Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Button Content="Quitar" Style="{StaticResource BtnPeligro}" Margin="0" Padding="8,3" Command="{Binding DataContext.QuitarEscenarioCmd, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Resultados (de menor a mayor costo unitario puesto en almacén)" Style="{StaticResource Subtitulo}"/>
                <DataGrid ItemsSource="{Binding Resultados}" IsReadOnly="True" MinHeight="80">
                  <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding EsMejor}" Value="True"><Setter Property="Background" Value="#DDF3E7"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Escenario" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Incoterm" Binding="{Binding Incoterm}" Width="80"/>
                    <DataGridTextColumn Header="CIF Bs" Binding="{Binding CifBob}" Width="110"/>
                    <DataGridTextColumn Header="Tributos Bs" Binding="{Binding Tributos}" Width="110"/>
                    <DataGridTextColumn Header="Costo unit. Bs" Binding="{Binding CostoUnitario}" Width="120"/>
                    <DataGridTextColumn Header="Margen" Binding="{Binding MargenPct}" Width="80"/>
                    <DataGridTextColumn Header="Veredicto" Binding="{Binding Veredicto}" Width="100"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <!-- ===================== CONTRASTE CON DIM ===================== -->
        <TabItem Header="Contraste">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel DataContext="{Binding Decision}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Compare el cálculo del sistema con los tributos que liquidó la Aduana en una DIM real" Style="{StaticResource Subtitulo}"/>
                <StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="GA (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="110" Text="{Binding DimGA}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="ICE (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="110" Text="{Binding DimICE}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="IEHD (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="110" Text="{Binding DimIEHD}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="IVA (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="110" Text="{Binding DimIVA}"/></StackPanel>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Tolerancia (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Width="90" Text="{Binding ToleranciaBs}"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal"><Button Content="Contrastar" Command="{Binding ContrastarCmd}"/><TextBlock Text="{Binding MensajeContraste}" VerticalAlignment="Center" Margin="10,0" Foreground="#8A5A00"/></StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Contraste}" IsReadOnly="True" AutoGenerateColumns="True" MinHeight="140"/></Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <!-- ===================== COSTOS REALES ===================== -->
        <TabItem Header="Costos">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Hoja de costos: lo proyectado frente a lo realmente pagado" Style="{StaticResource Subtitulo}"/>
                <TextBlock Style="{StaticResource Suave}" Text="Cargue lo proyectado desde la liquidación y anote en «Real» lo que efectivamente pagó (tributos de la DMI, agencia despachante, almacén, transporte). Así conocerá el costo final exacto de su importación."/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Cargar proyectado desde la liquidación" Command="{Binding CargarProyectadoCmd}"/>
                  <Button Content="Agregar costo" Command="{Binding AgregarCostoCmd}" Style="{StaticResource BtnSecundario}"/>
                  <Button Content="Guardar hoja" Command="{Binding GuardarCostosCmd}" Style="{StaticResource BtnExito}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DataGrid ItemsSource="{Binding Costos}" CanUserAddRows="False" MinHeight="120">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                    <DataGridTextColumn Header="Proyectado (Bs)" Binding="{Binding Proyectado, StringFormat=N2}" Width="140"/>
                    <DataGridTextColumn Header="Real (Bs)" Binding="{Binding Real, StringFormat=N2, TargetNullValue=''}" Width="140"/>
                    <DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" Width="180"/>
                    <DataGridTemplateColumn Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Button Content="Quitar" Style="{StaticResource BtnPeligro}" Margin="0" Padding="8,3" Command="{Binding DataContext.EliminarCostoCmd, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding TotalesCostos}" FontWeight="SemiBold" Foreground="{StaticResource TurquesaOscuro}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </TabItem>

        <!-- ===================== RUTA CRÍTICA ===================== -->
        <TabItem Header="Ruta">
          <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Etapas}" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Est." Width="46"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="14" Height="14" Fill="{Binding ColorHex, Converter={StaticResource ColorTexto}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Etapa" Binding="{Binding Codigo}" Width="60"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="110"/>
                <DataGridTextColumn Header="Real" Binding="{Binding Real}" Width="70"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Semaforo}" Width="90"/>
                <DataGridCheckBoxColumn Header="Crítica" Binding="{Binding EsCritica}" Width="64"/>
                <DataGridTemplateColumn Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Button Content="Marcar cumplida" Click="Cumplir_Click" Tag="{Binding}" Style="{StaticResource BtnSuave}" Margin="0" Padding="8,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </TabItem>

        <!-- ===================== LEGAJO Y BITÁCORA ===================== -->
        <TabItem Header="Legajo">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Documentos exigidos" Style="{StaticResource Subtitulo}"/>
                <ItemsControl ItemsSource="{Binding Legajo}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#E6EEF0" BorderThickness="0,0,0,1" Padding="0,6">
                    <StackPanel Orientation="Horizontal">
                      <Border CornerRadius="9" Padding="9,1" Margin="0,0,10,0" Width="56"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F9DCDB"/><Style.Triggers><DataTrigger Binding="{Binding Presente}" Value="True"><Setter Property="Background" Value="#D5F1E3"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="FALTA"/><Setter Property="Foreground" Value="#B03A36"/><Style.Triggers><DataTrigger Binding="{Binding Presente}" Value="True"><Setter Property="Text" Value="OK"/><Setter Property="Foreground" Value="#217A52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                      <StackPanel><TextBlock Text="{Binding Documento}" FontWeight="SemiBold"/><TextBlock Text="{Binding Motivo}" Style="{StaticResource Suave}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bitácora del proceso" Style="{StaticResource Subtitulo}"/>
                <ListBox ItemsSource="{Binding Bitacora}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- Barra de ruta crítica y estado -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Etapas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,10,2" ToolTip="{Binding Nombre}"><Ellipse Width="16" Height="16" Fill="{Binding ColorHex, Converter={StaticResource ColorTexto}}"/><TextBlock Text="{Binding Codigo}" FontSize="10" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Margin="0,4,0,0"><Run Text="{Binding ResumenSemaforos, Mode=OneWay}" Foreground="{StaticResource TextoSuave}"/><Run Text="     "/><Run Text="{Binding ProximoVencimiento, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Pizarra}"/></TextBlock>
          <TextBlock Text="{Binding Mensaje}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource TurquesaOscuro}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
