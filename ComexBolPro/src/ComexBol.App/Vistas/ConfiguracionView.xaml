<UserControl x:Class="ComexBol.App.Vistas.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8">
      <TextBlock Text="Configuración" Style="{StaticResource Titulo}"/>
      <TextBlock Text="Mantenimiento de tipos de cambio, UFV, parámetros tributarios, perfil del importador, usuarios y respaldo." Style="{StaticResource Suave}"/>
    </StackPanel>

    <TabControl Grid.Row="1">
      <!-- ===== Tipos de cambio ===== -->
      <TabItem Header="Tipos de cambio">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding TiposCambio}" SelectedItem="{Binding TcSeleccionado}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="110"/>
              <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="90"/>
              <DataGridTextColumn Header="Bs por unidad" Binding="{Binding BobPorUnidad, StringFormat=N4}" Width="130"/>
              <DataGridTextColumn Header="Fuente" Binding="{Binding Fuente}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Registrar o corregir" Style="{StaticResource Subtitulo}"/>
              <TextBlock Text="Fecha de vigencia" Style="{StaticResource Etiqueta}"/><DatePicker SelectedDate="{Binding TcFecha}"/>
              <TextBlock Text="Moneda" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Monedas}" SelectedItem="{Binding TcMoneda}"/>
              <TextBlock Text="Tipo de cambio oficial de venta (Bs por 1 unidad)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding TcValor}"/>
              <TextBlock Text="Fuente" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding TcFuente}"/>
              <TextBlock Style="{StaticResource Suave}" FontSize="11" Margin="0,0,0,8" Text="Si ya existe un valor para esa fecha y moneda, se corrige. El sistema usa el más reciente hasta la fecha de la operación."/>
              <StackPanel Orientation="Horizontal"><Button Content="Guardar" Command="{Binding GuardarTcCmd}" Style="{StaticResource BtnExito}"/><Button Content="Eliminar" Style="{StaticResource BtnPeligro}" Click="EliminarTc_Click" Margin="0"/></StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ===== UFV ===== -->
      <TabItem Header="UFV">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Ufvs}" SelectedItem="{Binding UfvSeleccionada}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="130"/>
              <DataGridTextColumn Header="Valor de la UFV (Bs)" Binding="{Binding ValorBob, StringFormat=N5}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Registrar o corregir" Style="{StaticResource Subtitulo}"/>
              <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/><DatePicker SelectedDate="{Binding UfvFecha}"/>
              <TextBlock Text="Valor de la UFV (Bs)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding UfvValor}"/>
              <TextBlock Style="{StaticResource Suave}" FontSize="11" Margin="0,0,0,8" Text="La UFV la publica el Banco Central de Bolivia. Se usa para expresar el valor en aduana en UFV en la liquidación."/>
              <StackPanel Orientation="Horizontal"><Button Content="Guardar" Command="{Binding GuardarUfvCmd}" Style="{StaticResource BtnExito}"/><Button Content="Eliminar" Style="{StaticResource BtnPeligro}" Click="EliminarUfv_Click" Margin="0"/></StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ===== Parámetros ===== -->
      <TabItem Header="Parámetros tributarios" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="620">
          <StackPanel>
            <TextBlock Text="Parámetros del cálculo de tributos" Style="{StaticResource Subtitulo}"/>
            <TextBlock Style="{StaticResource Suave}" Margin="0,0,0,10" Text="Son valores normativos que cambian por decreto. Verifíquelos con su despachante antes de modificarlos: afectan a todos los cálculos nuevos."/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="IVA efectivo en importaciones (%)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding IvaPct}"/>
                <TextBlock Text="Umbral de bancarización (Bs) – D.S. 772" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding UmbralBancarizacion}"/>
                <TextBlock Text="Alícuota máxima aceptada del GA (%)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding MaxGaPct}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Seguro presunto si no se declara (% del FOB)" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding SeguroPresuntoPct}"/>
                <TextBlock Text="Redondeo de tributos" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Redondeos}" SelectedItem="{Binding Redondeo}"/>
                <TextBlock Text="Reparto de flete y seguro entre ítems" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Prorrateos}" SelectedItem="{Binding Prorrateo}"/></StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal"><Button Content="Guardar parámetros" Command="{Binding GuardarParametrosCmd}" Style="{StaticResource BtnExito}"/><Button Content="Restaurar valores por defecto" Command="{Binding RestaurarParametrosCmd}" Style="{StaticResource BtnSuave}" Margin="0"/></StackPanel>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- ===== Perfil del importador ===== -->
      <TabItem Header="Perfil del importador">
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="620">
          <StackPanel>
            <TextBlock Text="Datos del importador" Style="{StaticResource Subtitulo}"/>
            <TextBlock Text="Razón social o nombre" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding RazonSocial}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="NIT" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Nit}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Tipo de importador (padrón de la Aduana)" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding TiposImportador}" SelectedItem="{Binding TipoImportador}"/></StackPanel>
            </Grid>
            <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Direccion}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Ciudad}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Telefono}"/></StackPanel>
            </Grid>
            <TextBlock Text="Correo electrónico" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding Correo}"/>
            <TextBlock Text="Agencia despachante de aduana habitual" Style="{StaticResource Etiqueta}"/><TextBox Text="{Binding AgenciaDespachante}"/>
            <Button Content="Guardar perfil" Command="{Binding GuardarPerfilCmd}" Style="{StaticResource BtnExito}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- ===== Usuarios ===== -->
      <TabItem Header="Usuarios" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolVis}}">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSeleccionado}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="130"/>
              <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*"/>
              <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="120"/>
              <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo, Mode=OneWay}" Width="70"/>
              <DataGridTextColumn Header="Último acceso" Binding="{Binding UltimoAcceso, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Nuevo usuario" Style="{StaticResource Subtitulo}"/>
                <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtNuevoUsuario"/>
                <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtNuevoNombre"/>
                <TextBlock Text="Clave (mínimo 6 caracteres)" Style="{StaticResource Etiqueta}"/><PasswordBox PasswordChar="*" x:Name="TxtNuevaClave"/>
                <TextBlock Text="Rol" Style="{StaticResource Etiqueta}"/><ComboBox x:Name="CmbRol" ItemsSource="{Binding Roles}" SelectedIndex="1"/>
                <Button Content="Crear usuario" Click="CrearUsuario_Click" Style="{StaticResource BtnExito}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Text="Usuario seleccionado" Style="{StaticResource Subtitulo}"/>
                <TextBlock Text="Nueva clave" Style="{StaticResource Etiqueta}"/><PasswordBox PasswordChar="*" x:Name="TxtClaveReset"/>
                <StackPanel Orientation="Horizontal"><Button Content="Cambiar clave" Click="CambiarClave_Click" Style="{StaticResource BtnSecundario}"/><Button Content="Activar / desactivar" Command="{Binding AlternarActivoCmd}" Click="AlternarActivo_Click" Style="{StaticResource BtnSuave}" Margin="0"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Administrador" Click="HacerAdmin_Click" Style="{StaticResource BtnSuave}"/><Button Content="Operador" Click="HacerOperador_Click" Style="{StaticResource BtnSuave}" Margin="0"/></StackPanel>
                <TextBlock Style="{StaticResource Suave}" FontSize="11" Margin="0,10,0,0" Text="Administrador: todo. Operador: trabaja con operaciones y consulta el arancel, pero no cambia parámetros, arancel ni usuarios."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ===== Datos y respaldo ===== -->
      <TabItem Header="Datos y respaldo">
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="680">
          <StackPanel>
            <TextBlock Text="Copia de seguridad" Style="{StaticResource Subtitulo}"/>
            <TextBlock Style="{StaticResource Suave}" Text="Toda su información (operaciones, arancel, configuración y usuarios) está en un único archivo. Haga copias periódicas y guárdelas fuera de este equipo."/>
            <TextBlock Text="Ubicación de la base de datos" Style="{StaticResource Etiqueta}" Margin="2,12,0,2"/>
            <TextBox Text="{Binding RutaBaseDatos, Mode=OneWay}" IsReadOnly="True" Background="#EEF3F4"/>
            <StackPanel Orientation="Horizontal"><Button Content="Crear copia de seguridad…" Click="Respaldo_Click" Style="{StaticResource BtnExito}"/><Button Content="Abrir la carpeta de datos" Click="AbrirCarpeta_Click" Style="{StaticResource BtnSuave}" Margin="0"/></StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8"><TextBlock Text="{Binding Mensaje}" FontWeight="SemiBold" Foreground="{StaticResource TurquesaOscuro}" TextWrapping="Wrap"/></Border>
  </Grid>
</UserControl>
