<Window x:Class="ComexBol.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMEX JB — Ingreso" Width="480" Height="780" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Texto}">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2F3E49" Offset="0"/><GradientStop Color="#405361" Offset="0.55"/><GradientStop Color="#5EA3A0" Offset="1"/></LinearGradientBrush>
  </Window.Background>
  <Grid>
    <Border Background="White" CornerRadius="14" Margin="34" Padding="28,22">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
      <StackPanel>
        <Image Source="/Assets/logo.png" Height="150" Margin="0,0,0,6"/>
        <TextBlock Text="COMEX JB" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Pizarra}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TxtSub" Text="Ingrese con su usuario" Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" Margin="0,2,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

        <StackPanel x:Name="PanelNombre" Visibility="Collapsed"><TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtNombre"/></StackPanel>
        <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtUsuario"/>
        <TextBlock Text="Clave" Style="{StaticResource Etiqueta}"/><PasswordBox PasswordChar="*" x:Name="TxtClave"/>
        <StackPanel x:Name="PanelRepetir" Visibility="Collapsed"><TextBlock Text="Repita la clave" Style="{StaticResource Etiqueta}"/><PasswordBox PasswordChar="*" x:Name="TxtRepetir"/></StackPanel>

        <TextBlock x:Name="TxtMensaje" Foreground="{StaticResource Rojo}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,8" MinHeight="20"/>
        <Button x:Name="BtnIngresar" Content="Ingresar" IsDefault="True" Click="Ingresar_Click" HorizontalAlignment="Stretch" Margin="0" Padding="14,10" FontSize="14"/>
        <TextBlock Text="Jaime Blanco Villegas · Importaciones y Representaciones" Style="{StaticResource Suave}" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
